// Prisma — stack decidido (CLAUDE.md). Fonte determinística da prospecção.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // runtime: pooled (Supabase pgbouncer 6543) ou local
  directUrl = env("DIRECT_URL") // migrations: conexão direta (5432); cai em DATABASE_URL se ausente
}

/// Estabelecimento da base aberta da Receita Federal (CNPJ).
/// Fonte determinística de empresas REAIS para a prospecção: razão social, atividade
/// (CNAE), endereço e contato vêm daqui — nunca do modelo (constituição §1/§2).
model EmpresaReceita {
  cnpj          String   @id @db.VarChar(14) // 14 dígitos, sem máscara
  razaoSocial   String
  nomeFantasia  String?
  cnaePrincipal String   @db.VarChar(7)
  situacao      String // ATIVA, BAIXADA, ...
  uf            String   @db.VarChar(2)
  municipioNome String?
  municipioCod  String?  @db.VarChar(7)
  bairro        String?
  logradouro    String?
  numero        String?
  cep           String?  @db.VarChar(8)
  telefone1     String? // dígitos: DDD + número
  telefone2     String?
  email         String?
  atualizadoEm  DateTime @updatedAt

  @@index([cnaePrincipal, uf])
  @@index([uf, municipioNome])
  @@index([situacao])
}

/// Proposta comercial persistida: o `PropostaScope` canônico (Json) + status comercial
/// MUTÁVEL (rascunho→enviada→aprovada/recusada). Espelha o contrato Zod
/// (src/lib/contracts/proposta.ts). É o store de trabalho — permite reabrir e gerar
/// contrato de uma proposta que já existe; o log append-only (lib/log.ts) segue como a
/// auditoria imutável de cada PDF emitido (constituição §8). Preço sempre Decimal (§stack).
model Proposta {
  id           String   @id // = PropostaScope.id (gerado na montagem)
  status       String   @default("em_andamento") // escolhíveis: em_andamento|enviada|aprovada|recusada · legados (só leitura): rascunho|em_edicao|arquivada
  autor        String // login da sessão (dado crítico não vem do cliente)
  cliente      String // razão social (denormalizado p/ listagem)
  segmento     String?
  tipo         String // orcamento|implantacao|comercial
  total        Decimal  @db.Decimal(12, 2) // Σ subtotais
  scope        Json // PropostaScope completo (objeto canônico que vira PDF/contrato)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([status])
  @@index([autor])
}

/// Chamado de suporte interno: o colaborador abre, o gestor (papel admin) resolve.
/// Enums (categoria/prioridade/status) são validados no contrato Zod (src/lib/contracts/chamado.ts).
model Chamado {
  id             String   @id @default(cuid())
  titulo         String
  descricao      String
  categoria      String // bug | duvida | sugestao | infra | outro
  prioridade     String // baixa | media | alta
  status         String   @default("aberto") // aberto | em_andamento | resolvido
  autor          String // login do colaborador (vem da sessão)
  respostaGestor String?
  criadoEm       DateTime @default(now())
  atualizadoEm   DateTime @updatedAt

  @@index([status])
  @@index([autor])
}

/// Cadastro de e-mail por cliente que APRENDE com o tempo: cada planilha de cobrança que
/// traz o e-mail de um cliente faz upsert aqui; cliente sem e-mail na planilha é preenchido
/// pelo que já foi aprendido. Editável pelo gestor no painel de admin.
model ContatoCliente {
  cliente      String   @id // razão social / nome (chave de casamento com a planilha)
  email        String
  atualizadoEm DateTime @updatedAt
}

/// Configurações simples chave→valor (ex.: gestorEmail = quem recebe o resumo de cobrança).
/// Editável pelo gestor no painel de admin.
model Config {
  chave String @id
  valor String
}

/// Conta de colaborador (cadastro próprio: nome + e-mail + senha). `credencial` é
/// "salt.hash" (PBKDF2 — ver src/lib/auth.ts), nunca a senha em texto puro. `papel` vem
/// de ADMIN_EMAILS (env) no momento do cadastro. Nome/e-mail alimentam a proposta
/// (consultor/contato — ver src/lib/montar.ts). `telefone` é editável pelo próprio
/// colaborador (/api/perfil) ou pelo gestor (/api/colaboradores, painel de admin).
/// Produto cadastrado PELA TELA (o gestor, em Catálogo → Novo produto). Os 150 produtos da
/// base INDEBA/PRATT continuam em data/catalogo.json: a função da Vercel é somente-leitura,
/// então gravar naquele arquivo em produção é impossível. `catalogoCompleto()` une as duas
/// fontes — ver docs/spec-cadastro-produto.md.
///
/// `dados` é o contrato Produto (Zod) inteiro em JSON, validado na entrada e na leitura:
/// mesmo formato do JSON, então todo consumidor (vitrine, matcher, RAG, PDF) trata igual.
/// Foto e ficha vão como bytes na própria linha em vez de um serviço de storage — para
/// dezenas de produtos é suficiente, e as rotas /api/produtos/<codigo>/imagem|ficha servem
/// o conteúdo. Se o volume crescer, só estas colunas e aquelas rotas mudam.
model ProdutoCustom {
  id           String   @id @default(cuid())
  codigo       String   @unique
  dados        Json
  /// Lápide: o produto foi EXCLUÍDO pelo gestor. Existe porque produto da base mora em
  /// data/catalogo.json — arquivo versionado, que a função da Vercel não pode reescrever —,
  /// então "sumir com ele" só é possível marcando aqui e filtrando na leitura. Vale para os
  /// dois tipos: o que nasceu na tela também vira lápide em vez de DELETE, para a exclusão
  /// ser reversível (o Matheus perdeu produto editando; apagar sem volta seria pior).
  excluido     Boolean  @default(false)
  // Opcionais desde que esta tabela passou a guardar também os OVERRIDES da base: editar o
  // preço de um produto do catálogo.json não exige reenviar a foto que já está versionada.
  imagem       Bytes?
  imagemMime   String?
  ficha        Bytes?
  fichaMime    String?
  autor        String // e-mail do gestor que cadastrou (dado crítico vem da sessão)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

/// Ferramentas Técnicas — Registro de Visitas da Carteira (áudio do Mateus, 21/08/2026):
/// data, horário, cliente, quem recebeu, telefone, status (resolvido/não resolvido) e
/// observação. Todo vendedor lança; cada um vê SÓ os seus registros, o gestor vê todos —
/// mesmo recorte por `autor` de Proposta/Chamado. Data e horário são strings como digitadas
/// (sem fuso): o registro é o que o vendedor anotou, não um instante de máquina.
model VisitaCarteira {
  id           String   @id @default(cuid())
  data         String // YYYY-MM-DD
  horario      String // HH:MM
  cliente      String
  quemRecebeu  String
  telefone     String?
  status       String   @default("nao_resolvido") // resolvido | nao_resolvido
  observacao   String?
  autor        String // login da sessão (dado crítico não vem do cliente)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([autor])
}

/// Ferramentas Técnicas — Contratos e Comodatos: nome do cliente, texto livre com os
/// comodatos do contrato, observações e a cópia do contrato em PDF. O PDF vai como bytes na
/// própria linha, igual à ficha de ProdutoCustom (mesmo raciocínio: volume pequeno, e a rota
/// /api/comodatos/<id>/pdf serve o conteúdo; se crescer, só esta coluna e aquela rota mudam).
model ContratoComodato {
  id           String   @id @default(cuid())
  cliente      String
  comodatos    String // texto livre: os comodatos deste cliente
  observacoes  String?
  contrato     Bytes?
  contratoMime String?
  autor        String
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([autor])
}

/// Ferramentas Técnicas — Estoque de Comodatos: código, peça, quantidade e observação.
/// Cada lançamento é uma linha (o "pontinho" de cada registro que o João fizer); a tela
/// exporta tudo para Excel/CSV.
model EstoqueComodato {
  id           String   @id @default(cuid())
  codigo       String
  peca         String
  quantidade   Int
  obs          String?
  autor        String
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([autor])
}

/// `acesso` é o portão de entrada, separado de `papel` (que é o que a pessoa pode fazer
/// DEPOIS de entrar): cadastro próprio é aberto, então quem se cadastra nasce `pendente` e
/// só passa do login quando o gestor aprova no painel de Configurações.
model Usuario {
  id         String   @id @default(cuid())
  nome       String
  email      String   @unique
  credencial String
  papel      String   @default("user") // admin | user
  acesso     String   @default("pendente") // pendente | aprovado | bloqueado
  telefone   String? // dígitos: DDD + número
  criadoEm   DateTime @default(now())

  @@index([acesso])
}
