// Prisma — stack decidido (CLAUDE.md). Fonte determinística da prospecção.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // runtime: pooled (Supabase pgbouncer 6543) ou local
  directUrl = env("DIRECT_URL") // migrations: conexão direta (5432); cai em DATABASE_URL se ausente
}

/// Estabelecimento da base aberta da Receita Federal (CNPJ).
/// Fonte determinística de empresas REAIS para a prospecção: razão social, atividade
/// (CNAE), endereço e contato vêm daqui — nunca do modelo (constituição §1/§2).
model EmpresaReceita {
  cnpj          String   @id @db.VarChar(14) // 14 dígitos, sem máscara
  razaoSocial   String
  nomeFantasia  String?
  cnaePrincipal String   @db.VarChar(7)
  situacao      String // ATIVA, BAIXADA, ...
  uf            String   @db.VarChar(2)
  municipioNome String?
  municipioCod  String?  @db.VarChar(7)
  bairro        String?
  logradouro    String?
  numero        String?
  cep           String?  @db.VarChar(8)
  telefone1     String? // dígitos: DDD + número
  telefone2     String?
  email         String?
  atualizadoEm  DateTime @updatedAt

  @@index([cnaePrincipal, uf])
  @@index([uf, municipioNome])
  @@index([situacao])
}

/// Proposta comercial persistida: o `PropostaScope` canônico (Json) + status comercial
/// MUTÁVEL (rascunho→enviada→aprovada/recusada). Espelha o contrato Zod
/// (src/lib/contracts/proposta.ts). É o store de trabalho — permite reabrir e gerar
/// contrato de uma proposta que já existe; o log append-only (lib/log.ts) segue como a
/// auditoria imutável de cada PDF emitido (constituição §8). Preço sempre Decimal (§stack).
model Proposta {
  id           String   @id // = PropostaScope.id (gerado na montagem)
  status       String   @default("rascunho") // rascunho|em_edicao|enviada|aprovada|recusada
  autor        String // login da sessão (dado crítico não vem do cliente)
  cliente      String // razão social (denormalizado p/ listagem)
  segmento     String?
  tipo         String // orcamento|implantacao|comercial
  total        Decimal  @db.Decimal(12, 2) // Σ subtotais
  scope        Json // PropostaScope completo (objeto canônico que vira PDF/contrato)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([status])
  @@index([autor])
}

/// Chamado de suporte interno: o colaborador abre, o gestor (papel admin) resolve.
/// Enums (categoria/prioridade/status) são validados no contrato Zod (src/lib/contracts/chamado.ts).
model Chamado {
  id             String   @id @default(cuid())
  titulo         String
  descricao      String
  categoria      String // bug | duvida | sugestao | infra | outro
  prioridade     String // baixa | media | alta
  status         String   @default("aberto") // aberto | em_andamento | resolvido
  autor          String // login do colaborador (vem da sessão)
  respostaGestor String?
  criadoEm       DateTime @default(now())
  atualizadoEm   DateTime @updatedAt

  @@index([status])
  @@index([autor])
}

/// Cadastro de e-mail por cliente que APRENDE com o tempo: cada planilha de cobrança que
/// traz o e-mail de um cliente faz upsert aqui; cliente sem e-mail na planilha é preenchido
/// pelo que já foi aprendido. Editável pelo gestor no painel de admin.
model ContatoCliente {
  cliente      String   @id // razão social / nome (chave de casamento com a planilha)
  email        String
  atualizadoEm DateTime @updatedAt
}

/// Configurações simples chave→valor (ex.: gestorEmail = quem recebe o resumo de cobrança).
/// Editável pelo gestor no painel de admin.
model Config {
  chave String @id
  valor String
}

/// Conta de colaborador (cadastro próprio: nome + e-mail + senha). `credencial` é
/// "salt.hash" (PBKDF2 — ver src/lib/auth.ts), nunca a senha em texto puro. `papel` vem
/// de ADMIN_EMAILS (env) no momento do cadastro. Nome/e-mail alimentam a proposta
/// (consultor/contato — ver src/lib/montar.ts). `telefone` é editável pelo próprio
/// colaborador (/api/perfil) ou pelo gestor (/api/colaboradores, painel de admin).
model Usuario {
  id         String   @id @default(cuid())
  nome       String
  email      String   @unique
  credencial String
  papel      String   @default("user") // admin | user
  telefone   String? // dígitos: DDD + número
  criadoEm   DateTime @default(now())
}
