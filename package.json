{
  "name": "indeba-proposta-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d db",
    "db:migrate": "prisma migrate dev",
    "db:seed-amostra": "node --env-file=.env.local prisma/seed-amostra.mjs",
    "rag:up": "docker compose up -d qdrant",
    "rag:index": "node --env-file=.env.local scripts/rag-index.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "@sparticuz/chromium": "^149.0.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "fast-xml-parser": "^5.9.3",
    "geist": "^1.7.2",
    "mammoth": "^1.12.0",
    "next": "16.2.9",
    "nodemailer": "^9.0.1",
    "pdfjs-dist": "^6.0.227",
    "playwright": "^1.62.1",
    "playwright-core": "^1.62.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.35.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "prisma": "^6.16.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
