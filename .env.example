# Configuração do Agente de Proposta.
# Local: copie para .env.local. Vercel: configure no dashboard (Settings → Environment Variables).
# NUNCA comite segredos — .env.local é gitignored; .env.example só tem placeholders.

# ── Banco (Postgres via docker-compose) ───────────────────────
# Base aberta da Receita p/ prospecção determinística (empresas reais por CNAE+local).
# Suba com: docker compose up -d db
# Local: docker-compose. Produção (Vercel): Supabase → DATABASE_URL = pooler (6543),
# DIRECT_URL = conexão direta (5432, usada só nas migrations).
DATABASE_URL=postgresql://indeba:indeba@localhost:5432/indeba?schema=public
DIRECT_URL=postgresql://indeba:indeba@localhost:5432/indeba?schema=public

# ── IA (Ollama) ───────────────────────────────────────────────
# Local: localhost. Na Vercel: aponte para seu Ollama exposto via TÚNEL SEGURO
# (cloudflared/ngrok com autenticação) — nunca exponha o Ollama sem proteção.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
# Modelo para o TEXTO que o cliente lê (apresentação da proposta + cláusulas do contrato).
# Default qwen3:14b (responde melhor que o 7B). Puxe com: ollama pull qwen3:14b
OLLAMA_MODEL_TEXTO=qwen3:14b
# OPCIONAL. Modelo só para os posts de Instagram (copy melhor). Ex.: qwen3:14b. Vazio = usa OLLAMA_MODEL.
OLLAMA_MODEL_POSTS=
# OPCIONAL. Modelo de VISÃO p/ analisar as referências de estilo (pasta do Drive). Default: qwen2.5vl:7b.
OLLAMA_MODEL_VISAO=qwen2.5vl:7b
# Modelo de EMBEDDINGS do RAG (Atendimento). Leve, roda junto do 7B. Puxe com:
# ollama pull nomic-embed-text   (PT melhor: bge-m3, porém ~2GB — ver memória modelo-hardware)
OLLAMA_EMBED_MODEL=nomic-embed-text
# Auth do túnel Ollama (Vercel→PC). Escolha UM modo (ou nenhum em dev local):
#  (B) Proxy local com bearer (grátis, sem domínio): rode scripts/ollama-proxy.mjs com o
#      MESMO token e aponte o cloudflared pro proxy (porta 11435). App manda Authorization: Bearer.
OLLAMA_AUTH_TOKEN=
#  (A) Cloudflare Access (named tunnel): service token do Zero Trust → Access → Service Auth.
OLLAMA_CF_ACCESS_CLIENT_ID=
OLLAMA_CF_ACCESS_CLIENT_SECRET=
MARCA_PADRAO=indeba_express
NEXT_TELEMETRY_DISABLED=1

# ── App / PDF ──────────────────────────────────────────────────
# URL pública de produção (Vercel), usada só pra montar o link "Ver ficha técnica
# completa" na proposta em PDF — precisa ser absoluta (o PDF é aberto fora do navegador).
# Vazio = o link não aparece (nunca gera link relativo/quebrado).
SITE_URL=

# ── RAG / Atendimento (Qdrant via docker-compose) ─────────────
# Vector DB local. Suba com: docker compose up -d qdrant
QDRANT_URL=http://localhost:6333
# OPCIONAL. Chave da API do Qdrant (se você protegê-lo). Vazio = sem auth (local).
QDRANT_API_KEY=
# OPCIONAL. Nome da coleção e score mínimo de relevância (abaixo disso → "não sei").
QDRANT_COLLECTION=indeba_rag
RAG_SCORE_MIN=0.35

# ── Prospecção de leads (Tavily) ──────────────────────────────
# OPCIONAL. Sem a chave, a prospecção roda só com o conhecimento do modelo.
# Com a chave, enriquece os prospects com busca web. Obtenha em: https://app.tavily.com
TAVILY_API_KEY=

# ── Cobrança por e-mail (SMTP direto — sem n8n) ───────────────
# O disparo (/api/cobranca/disparar) envia direto via SMTP: e-mail a cada cliente com
# e-mail (corpo = a régua do motor) + resumo ao gestor. Roda nativo na Vercel (serverless),
# não depende de n8n/PC ligado. Sem domínio, use Gmail + app password (Conta Google →
# Segurança → Verificação em 2 etapas → Senhas de app).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=seu.email@gmail.com
SMTP_PASS=
# Remetente (opcional; default = SMTP_USER).
SMTP_FROM=
# E-mail padrão do gestor (editável no painel de admin → persistido no banco).
GESTOR_EMAIL=

# ── Acesso / login ────────────────────────────────────────────
# Cadastro próprio: cada colaborador cria a conta (nome/e-mail/senha) em /cadastro —
# fica na tabela Usuario (Prisma), senha em HASH (PBKDF2), nunca texto puro.
# E-mails que devem nascer ADMIN ao se cadastrar, separados por vírgula. Todo o resto
# nasce "user". VAZIO = ninguém nasce admin (promova direto no banco).
ADMIN_EMAILS=
# Desliga a autenticação (uso local em 127.0.0.1, sem ninguém cadastrado ainda).
# Ausente/qualquer valor != "false" = auth LIGADA (produção sempre deve ficar assim).
AUTH_ENABLED=
# Segredo para assinar o cookie de sessão — gere um valor longo e aleatório.
# (ex.: openssl rand -hex 32). Sem isto em produção, o cookie é forjável.
AUTH_SESSION_SECRET=

# ── Contato na Proposta de Solução (PDF consolidado) ──────────
# Renderizados no rodapé de cada ficha de produto e no card de Condições Comerciais.
# VAZIO = o PDF simplesmente não exibe contato nenhum (nunca sai número/e-mail fictício) —
# mas a Revisão avisa visivelmente quando os dois estão vazios.
# WhatsApp: não há telefone por usuário — preencha com o real da Indeba.
INDEBA_WHATSAPP=
# E-mail do consultor: por padrão vem do usuário LOGADO (cadastro em /cadastro). Este
# valor é só o FALLBACK (dev local sem sessão ativa).
INDEBA_CONSULTOR_EMAIL=

# ── Rate limit (Upstash Redis) ────────────────────────────────
# Sem estes, o rate limit fica DESLIGADO. Recomendado em produção (endpoint público).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
