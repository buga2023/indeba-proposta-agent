# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# PDFs gerados (saída do render)
/generated/*
!/generated/.gitkeep

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ferramentas e notas internas de desenvolvimento (fora do repo)
# As SKILLS são exceção: descrevem o processo do projeto (como fazer deploy, como
# transcrever os áudios do Mateus) e valem para o time inteiro, não só para uma máquina.
# O resto de .claude/ continua local — settings.local.json, locks e worktrees são de cada um.
.claude/*
!.claude/skills/
CLAUDE.md
Guia_Desenvolvimento_Agente_Proposta.md
files.zip

# material de origem sensível: propostas reais de clientes, áudios, orçamentos
docs/evidencia/
*.ogg

.vercel

# logs locais de deploy/tunel/dev
cf.log
deploy*.log
dev.log

# perfil de estilo derivado das referencias (artefato de runtime; gerado via /api/referencias/sync)
/data/referencias/

# Autostart do backend de IA (Ollama+proxy+túnel) — artefatos locais, não versionar.
scripts/autostart.log
scripts/.ollama-tunnel-url
deploy-autostart.log

# materiais de trabalho soltos na raiz (zips fonte de ficha técnica/foto, rascunhos
# de proposta em PDF/HTML, prints) — não fazem parte do produto, ficam só locais
/*.zip
/*.pdf
/*.html
/*.png

# Saída do QA de PDF (tests/qa-proposta.qa.ts) — artefato local, nunca versionado.
tests/__saida-qa/

# Environment & Secrets (AIOX)
.env
.env.local
.env.*.local
*.key

# Dependencies (AIOX)
node_modules/

# Build & Logs (AIOX)
dist/
build/
*.log
logs/

# IDE & OS (AIOX)
Thumbs.db
.idea/
*.swp

# AIOX Local (AIOX)
.aiox-core/local/
.claude/settings.local.json
.aiox/install-log.txt

# Playwright
test-results/
playwright-report/
package-lock.json
