# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# PDFs gerados (saída do render)
/generated/*
!/generated/.gitkeep

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ferramentas e notas internas de desenvolvimento (fora do repo)
.claude/
CLAUDE.md
Guia_Desenvolvimento_Agente_Proposta.md
files.zip

# material de origem sensível: propostas reais de clientes, áudios, orçamentos
docs/evidencia/
*.ogg

.vercel

# logs locais de deploy/tunel/dev
cf.log
deploy*.log
dev.log

# perfil de estilo derivado das referencias (artefato de runtime; gerado via /api/referencias/sync)
/data/referencias/
