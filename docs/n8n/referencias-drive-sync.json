{
  "name": "Referências de estilo — Google Drive → Agente de Proposta",
  "nodes": [
    {
      "parameters": {},
      "id": "trigger-manual",
      "name": "Disparar manualmente",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "resource": "fileFolder",
        "operation": "search",
        "searchMethod": "query",
        "queryString": "'1ozIa5X5GDUm_8UDFkaoJodhpV3rw6lcN' in parents and mimeType contains 'image/' and trashed = false",
        "returnAll": true,
        "filter": {},
        "options": {}
      },
      "id": "drive-listar",
      "name": "Drive — listar arquivos da pasta",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [220, 0],
      "credentials": {
        "googleDriveOAuth2Api": { "id": "TROQUE", "name": "Google Drive (sua conta)" }
      }
    },
    {
      "parameters": {
        "resource": "file",
        "operation": "download",
        "fileId": { "__rl": true, "value": "={{ $json.id }}", "mode": "id" },
        "options": {}
      },
      "id": "drive-baixar",
      "name": "Drive — baixar imagem",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [660, 0],
      "credentials": {
        "googleDriveOAuth2Api": { "id": "TROQUE", "name": "Google Drive (sua conta)" }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Binário → base64 ROBUSTO (funciona em modo memória E filesystem) via helper oficial.\nconst items = $input.all();\nconst out = [];\nfor (let i = 0; i < items.length; i++) {\n  const buf = await this.helpers.getBinaryDataBuffer(i, 'data');\n  out.push({\n    json: {\n      nomeArquivo: items[i].json.name,\n      imagemBase64: buf.toString('base64'),\n      legenda: items[i].json.description || null,\n    },\n    pairedItem: { item: i },\n  });\n}\nreturn out;"
      },
      "id": "para-base64",
      "name": "Imagem → base64",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [880, 0]
    },
    {
      "parameters": {
        "mode": "combine",
        "fieldsToAggregate": {
          "fieldToAggregate": [{ "fieldToAggregate": "" }]
        },
        "options": {},
        "aggregate": "aggregateAllItemData"
      },
      "id": "agrupar",
      "name": "Agrupar num array 'itens'",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [1100, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:3000/api/referencias/sync",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { itens: $json.data } }}",
        "options": { "timeout": 300000 }
      },
      "id": "post-sync",
      "name": "POST /api/referencias/sync",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1320, 0]
    }
  ],
  "connections": {
    "Disparar manualmente": { "main": [[{ "node": "Drive — listar arquivos da pasta", "type": "main", "index": 0 }]] },
    "Drive — listar arquivos da pasta": { "main": [[{ "node": "Drive — baixar imagem", "type": "main", "index": 0 }]] },
    "Drive — baixar imagem": { "main": [[{ "node": "Imagem → base64", "type": "main", "index": 0 }]] },
    "Imagem → base64": { "main": [[{ "node": "Agrupar num array 'itens'", "type": "main", "index": 0 }]] },
    "Agrupar num array 'itens'": { "main": [[{ "node": "POST /api/referencias/sync", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
